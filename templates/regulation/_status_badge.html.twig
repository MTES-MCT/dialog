{# Statut d'affichage : « draft » tel quel ; pour un arrêté publié, on affine selon les
   dates (passé / en vigueur / à venir), avec repli sur « published » neutre sans dates.
   Même logique de calcul (au jour près, fuseau client) que l'ancienne mention de la
   colonne Période de la liste des arrêtés. #}
{% set startDate = startDate|default(null) %}
{% set endDate = endDate|default(null) %}

{% if status == 'draft' %}
    {% set displayStatus = 'draft' %}
{% elseif startDate is null %}
    {% set displayStatus = 'published' %}
{% elseif app_is_client_future_day(startDate) %}
    {% set displayStatus = 'upcoming' %}
{% elseif endDate and app_is_client_past_day(endDate) %}
    {% set displayStatus = 'past' %}
{% else %}
    {% set displayStatus = 'current' %}
{% endif %}

{% set badgeClasses = {
    draft: 'fr-badge--info',
    published: '',
    past: 'fr-badge--icon-left fr-icon-checkbox-circle-line',
    current: 'fr-badge--success',
    upcoming: 'fr-badge--purple-glycine fr-badge--icon-left fr-icon-time-line',
} %}

<span class="fr-mt-2v fr-badge {{ badgeClasses[displayStatus] }}" data-testid="status-badge">
    {{ ('regulation.status_badge.' ~ displayStatus ~ '.text')|trans }}
</span>

{% if withHint|default(false) %}
    {# L'infobulle décrit la visibilité des données, qui ne dépend que de brouillon/publié. #}
    <p class="fr-text--sm fr-x-text--mention-grey fr-mt-1v fr-mb-0">
        {{ ('regulation.status_badge.' ~ status ~ '.hint')|trans }}
    </p>
{% endif %}
