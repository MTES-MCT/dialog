#!/usr/bin/env python3
import argparse
import json
import os
import signal
import subprocess
import sys
from contextlib import ExitStack
from dataclasses import dataclass
from pathlib import Path
from urllib.parse import urlparse


# Credit: https://stackoverflow.com/a/1094933
def _sizeof_fmt(num: float, suffix: str = "B") -> str:
    for unit in ("", "Ki", "Mi", "Gi", "Ti", "Pi", "Ei", "Zi"):
        if abs(num) < 1024.0:
            return f"{num:3.1f} {unit}{suffix}"
        num /= 1024.0
    return f"{num:.1f} Yi{suffix}"


def _run_dockerized_ogr2ogr(
    database_url,
    source: str,
    options: list,
    volume: tuple[str, str] | None = None,
    extra_env: dict[str, str] | None = None,
):
    # Make ogr2ogr access database tunnel connection open on the host
    # https://stackoverflow.com/a/43541732
    urlobj = urlparse(database_url)
    database_url_from_container = urlobj._replace(
        netloc=f"{urlobj.username}:{urlobj.password}@host.docker.internal:{urlobj.port}"
    ).geturl()

    command = [
        "docker",
        "compose",
        "-f",
        "docker-compose.yml",
        "--profile",
        "gdal",
        "run",
        "--rm",  # Do not leave dead containers
    ]

    # Mount the local data directory (local import mode only).
    if volume is not None:
        host_dir, container_dir = volume
        command += ["-v", f"{host_dir}:{container_dir}"]

    # Forward S3 credentials/config to GDAL (S3 streaming import mode only).
    for key, value in (extra_env or {}).items():
        command += ["-e", f"{key}={value}"]

    command += [
        "gdal",
        "ogr2ogr",
        # Setup connection to the PostgreSQL database
        # See specific PostgreSQL options here:
        # https://gdal.org/drivers/vector/pg.html
        "-f",
        "PostgreSQL",
        f"PG:{database_url_from_container}",
        *options,
        source,
    ]

    return subprocess.run(command)


def _build_s3_env(endpoint: str, region: str) -> dict[str, str]:
    """Translate the Flysystem/Outscale S3 configuration into GDAL /vsis3/ variables."""
    urlobj = urlparse(endpoint if "://" in endpoint else f"https://{endpoint}")
    host = urlobj.netloc or urlobj.path

    access_key = os.environ.get("S3_ACCESS_KEY")
    secret_key = os.environ.get("S3_SECRET_KEY")

    if not access_key or not secret_key:
        raise RuntimeError(
            "S3_ACCESS_KEY and S3_SECRET_KEY must be set for S3 streaming import"
        )

    return {
        "AWS_ACCESS_KEY_ID": access_key,
        "AWS_SECRET_ACCESS_KEY": secret_key,
        "AWS_S3_ENDPOINT": host,
        "AWS_REGION": region,
        "AWS_DEFAULT_REGION": region,
        # Outscale uses HTTPS and path-style addressing (pathStyleEndpoint: true).
        "AWS_HTTPS": "NO" if urlobj.scheme == "http" else "YES",
        "AWS_VIRTUAL_HOSTING": "FALSE",
    }


@dataclass
class Table:
    name: str
    select_sql: str | list[str] | None = None

    def __post_init__(self):
        if isinstance(self.select_sql, list):
            self.select_sql = "\n".join(self.select_sql)


@dataclass
class Config:
    tables: list[Table]


@dataclass
class S3Source:
    bucket: str
    key: str
    endpoint: str
    region: str
    entries: list[dict]


def _build_local_items(directory: Path, tables_by_name: dict) -> list[dict]:
    """Build the list of geopackages to import from a locally extracted directory."""
    items = []

    for theme in ("TRANSPORT", "ADRESSES"):
        search_pattern = f"**/1_DONNEES_LIVRAISON_*/*/{theme}/*.gpkg"

        for path in directory.glob(search_pattern):
            if path.stem in tables_by_name:
                items.append(
                    {
                        "table": tables_by_name[path.stem],
                        "source": str(Path("/home/data") / path.relative_to(directory)),
                        "volume": (str(directory), "/home/data"),
                        "env": None,
                        "size": path.stat().st_size,
                        "display": str(path),
                    }
                )

    return items


def _build_s3_items(s3: "S3Source", tables_by_name: dict) -> list[dict]:
    """Build the list of geopackages to import by streaming from a .7z archive on S3.

    Each source uses GDAL virtual filesystems to read the target geopackage directly
    inside the (single-volume) 7z archive stored on S3, without any local extraction:
    /vsi7z//vsis3/<bucket>/<key>/<path inside archive>
    """
    env = _build_s3_env(s3.endpoint, s3.region)
    items = []

    for entry in s3.entries:
        table = tables_by_name.get(entry["table"])

        if table is None:
            continue

        source = f"/vsi7z//vsis3/{s3.bucket}/{s3.key}/{entry['path']}"
        items.append(
            {
                "table": table,
                "source": source,
                "volume": None,
                "env": env,
                "size": entry.get("size"),
                "display": source,
            }
        )

    return items


def main(
    config: Config,
    directory: Path | None,
    url: str | None,
    overwrite: bool,
    yes: bool,
    s3: "S3Source | None" = None,
) -> int:
    tables_by_name = {table.name: table for table in config.tables}

    if s3 is not None:
        geopackages = _build_s3_items(s3, tables_by_name)
        source_label = f"s3://{s3.bucket}/{s3.key}"
    else:
        if directory is None or not directory.exists():
            print(f"ERROR: directory {directory} does not exist", file=sys.stderr)
            return 1

        geopackages = _build_local_items(directory, tables_by_name)
        source_label = str(directory)

    if not geopackages:
        print(f"ERROR: no geopackages found at {source_label}", file=sys.stderr)
        return 1

    # Improve pg disk usage by importing smallest packages first.
    # Reason: ogr2ogr runs TRUNCATE *after* importing the 1st package.
    geopackages = sorted(geopackages, key=lambda t: t["size"] or 0)

    with ExitStack() as exit_stack:
        if url is not None:
            urlobj = urlparse(url)

            if urlobj.scheme not in ("postgres", "postgresql"):
                print(
                    f"ERROR: invalid database URL: {url}: "
                    f"unexpected scheme: {urlobj.scheme} "
                    "(expected postgres:// or postgresql://)"
                )
                return 1

            if urlobj.hostname not in ("localhost", "127.0.0.1"):
                print(
                    "ERROR: expected url to be on localhost, "
                    f"received: {urlobj.hostname}"
                )
                return 1

            database_url = url
        else:
            app = "dialog-bdtopo-2025"

            print(f"===> Opening DB tunnel to {app}...")

            tunnel_proc = exit_stack.enter_context(
                subprocess.Popen(
                    ["./tools/scalingodbtunnel", app, "--host-url"],
                    stdout=subprocess.PIPE,
                )
            )

            def _close_tunnel():
                print("---> Stopping tunnel...")
                tunnel_proc.send_signal(signal.SIGINT)
                tunnel_proc.wait()

            exit_stack.callback(_close_tunnel)

            database_url = (
                tunnel_proc.stdout.readline()
                .decode()
                .strip()  # Remove any final newline
            )

            if not database_url:
                print(
                    "ERROR: failed to open DB tunnel, see output above",
                    file=sys.stderr,
                )
                return 1

            print("---> Tunnel open.")

        # ogr2ogr only seems to support postgresql://, especially when query parameters
        # are provided, such as '?sslmode=prefer' by Scalingo.
        database_url = database_url.replace("postgres://", "postgresql://")

        print("===> Import info:")
        print("Database URL:", database_url)
        print("Import mode:", "overwrite" if overwrite else "append")

        if not yes and input("------> Proceed? (y/N) ") != "y":
            return 1

        print("===> Importing BD TOPO content...")
        tables_seen = set()

        try:
            for gpkg in geopackages:
                table = gpkg["table"]  # type: Table

                pretty_size = (
                    _sizeof_fmt(gpkg["size"]) if gpkg["size"] else "unknown size"
                )
                print(
                    f"------> Import into {table.name}: {gpkg['display']} ({pretty_size})"
                )

                options = [
                    # See general ogr2ogr options here:
                    # https://gdal.org/programs/ogr2ogr.html
                    "-progress",
                    # Define the table name on initial import
                    "-nln",
                    table.name,
                    # Reproject all geometries to standard WGS 84 projection, aka EPSG 4326
                    # (Geopackages in BD TOPO may not all use the same projection)
                    "-t_srs",
                    "EPSG:4326",
                    # Append to existing data, or overwrite for faster re-ingestion
                    "-overwrite" if overwrite and table.name not in tables_seen else "-append",
                    # Use provided SQL statement, if any, to only import certain columns
                    # (In this case, progress bar won't be available due a limitation of the ogr2ogr Postgres driver)
                    *(["-sql", table.select_sql] if table.select_sql else []),
                    # Enable slightly faster ingestion
                    # https://gdal.org/drivers/vector/pg.html#config-PG_USE_COPY
                    "--config",
                    "PG_USE_COPY",
                    "YES",
                    # Explicitly set the name of the FID column to create
                    "-lco",
                    "FID=ogc_fid",
                ]

                if overwrite and table.name not in tables_seen:
                    options.extend(
                        [
                            # Remove existing tuples before importing (saves disk space
                            # at the cost of some unavailability during execution)
                            # https://gis.stackexchange.com/a/357040
                            # This should only run once per table so that all packages
                            # are effectively appended.
                            "--config",
                            "OGR_TRUNCATE",
                            "YES",
                        ]
                    )

                    tables_seen.add(table.name)

                result = _run_dockerized_ogr2ogr(
                    database_url,
                    source=gpkg["source"],
                    options=options,
                    volume=gpkg["volume"],
                    extra_env=gpkg["env"],
                )

                if result.returncode:
                    print(
                        "ERROR: ogr2ogr command failed, see output above",
                        file=sys.stderr,
                    )
                    return 1

            print("------> Import successful!")

            # Clear up dead tuples and update table statistics so that the
            # tables can be queried immediately.
            print("===> Running VACUUM ANALYZE...")
            analyze_stmt = f"VACUUM (ANALYZE, VERBOSE) {', '.join(tables_seen)};"
            print("------>", analyze_stmt)
            result = subprocess.run(
                [
                    "psql",
                    database_url,
                    # Avoid 'No space left on device' error when available RAM is short
                    "-c",
                    "SET max_parallel_maintenance_workers = 0;",
                    "-c",
                    analyze_stmt,
                ]
            )
            result.check_returncode()
            print("------> VACUUM ANALYZE ran successfully!")

            if overwrite:
                print(
                    "===> NOTE: run 'make bdtopo_setup_indexes' "
                    "to recreate indexes"
                )
        except KeyboardInterrupt:
            # ogr2ogr already manages most of the cleanup for us, nothing to do.
            return 2
        else:
            print("===> Done")

    return 0


def _path_check_exists(value: str) -> Path:
    path = Path(value)

    if not path.exists():
        raise argparse.ArgumentTypeError(f"file or directory not found: {value}")

    return path


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "directory",
        nargs="?",
        type=_path_check_exists,
        default=None,
        help="Path to directory containing BD TOPO data (local import mode)",
    )
    parser.add_argument(
        "--prod", action="store_true", help="Confirm deployment to 'dialog-bdtopo-2025' app"
    )
    parser.add_argument(
        "--url",
        help="Deploy to a PostgreSQL database identified by this database URL",
        default=None,
    )
    parser.add_argument(
        "--overwrite", action="store_true", help="Recreate tables instead of appending"
    )
    parser.add_argument("-y", "--yes", action="store_true", help="Accept all prompts")
    parser.add_argument(
        "-c",
        "--config",
        type=_path_check_exists,
        default=Path(__file__).parent / "bdtopo_update.config.json",
        help="Path to config file. Default: ./bdtopo_update.config.json",
    )
    parser.add_argument(
        "--s3-archive",
        default=None,
        help=(
            "Stream the import directly from a single-volume .7z archive on S3, "
            "e.g. s3://my-bucket/bdtopo/bdtopo-latest.7z (no local extraction). "
            "Requires --manifest, --s3-endpoint and --s3-region."
        ),
    )
    parser.add_argument(
        "--manifest",
        type=_path_check_exists,
        default=None,
        help="Path to the JSON manifest describing the geopackages inside the S3 archive",
    )
    parser.add_argument(
        "--s3-endpoint",
        default=None,
        help="S3 endpoint (e.g. https://oos.cloudgouv-eu-west-1.outscale.com)",
    )
    parser.add_argument(
        "--s3-region",
        default=None,
        help="S3 region (e.g. cloudgouv-eu-west-1)",
    )
    args = parser.parse_args()

    if args.url is None and not args.prod:
        print(
            "ERROR: please pass --prod to deploy to 'dialog-bdtopo-2025' environment, "
            "or --url to target a specific PostgreSQL database",
            file=sys.stderr,
        )
        sys.exit(1)

    configdata = json.loads(args.config.read_text())

    config = Config(
        tables=[Table(**t) for t in configdata["tables"]],
    )

    s3_source = None
    directory = None

    if args.s3_archive:
        if not (args.manifest and args.s3_endpoint and args.s3_region):
            print(
                "ERROR: --s3-archive requires --manifest, --s3-endpoint and --s3-region",
                file=sys.stderr,
            )
            sys.exit(1)

        archive_url = urlparse(args.s3_archive)

        if archive_url.scheme != "s3":
            print(
                f"ERROR: --s3-archive must be an s3:// URL, received: {args.s3_archive}",
                file=sys.stderr,
            )
            sys.exit(1)

        manifest_data = json.loads(args.manifest.read_text())

        s3_source = S3Source(
            bucket=archive_url.netloc,
            key=archive_url.path.lstrip("/"),
            endpoint=args.s3_endpoint,
            region=args.s3_region,
            entries=manifest_data["entries"],
        )
    else:
        if args.directory is None:
            print(
                "ERROR: please pass a directory (local mode) or --s3-archive (S3 mode)",
                file=sys.stderr,
            )
            sys.exit(1)

        # Relative paths are OK but ogr2ogr volume will require an absolute path.
        directory = args.directory.absolute()

    sys.exit(
        main(
            config,
            directory=directory,
            url=args.url,
            overwrite=args.overwrite,
            yes=args.yes,
            s3=s3_source,
        )
    )
