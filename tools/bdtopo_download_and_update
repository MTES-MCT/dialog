#!/usr/bin/env python3
"""
Script d'automatisation pour télécharger, dézipper et importer les données BDTOPO EXPRESS.

Compatible avec macOS, Linux et la CI GitHub Actions.

Usage:
    ./tools/bdtopo_download_and_update [--download-dir DIR] [--keep-archives] [--skip-download] [--skip-import] [--url] [--prod [2025|2025_2]] [--overwrite] [-y]

Options:
    --download-dir DIR     Répertoire où télécharger et dézipper les données
                           (défaut: ./dump en local, /tmp/bdtopo_download dans la CI)
    --keep-archives         Conserver les archives .7z après dézippage
    --skip-download         Ignorer le téléchargement (utiliser les fichiers déjà présents)
    --skip-import           Ignorer l'import (seulement télécharger et dézipper)
    --prod [TARGET]         Déployer vers une base de production
                           (`2025` par défaut, ou `2025_2`)
    --overwrite             Réécrire les tables au lieu d'ajouter
    --skip-migrate          Ignorer l'exécution des migrations d'index après l'import
    -y, --yes               Accepter toutes les confirmations

Note:
    Après un --overwrite, les migrations d'index sont automatiquement exécutées
    (sauf si --skip-migrate est spécifié) pour recréer tous les index.

Prérequis:
    - Python 3 avec requests et beautifulsoup4:
      * Sur macOS (Python géré par Homebrew): pip3 install --user requests beautifulsoup4
        (ou utiliser un environnement virtuel: python3 -m venv venv && source venv/bin/activate && pip install requests beautifulsoup4)
      * Sur Linux: pip install requests beautifulsoup4 (ou pip3 install requests beautifulsoup4)
    - 7z (p7zip) ou py7zr:
      * macOS: brew install p7zip
      * Linux: sudo apt-get install p7zip-full (Debian/Ubuntu) ou sudo yum install p7zip-plugins (RedHat/CentOS)
      * ou: pip3 install --user py7zr (mais ne gère pas les archives multi-volumes)
"""
import argparse
import json
import os
import platform
import re
import shutil
import signal
import subprocess
import sys
from datetime import datetime, timedelta
from pathlib import Path
from urllib.parse import urlparse

try:
    import requests
except ImportError:
    print(
        "ERROR: Le module 'requests' est requis. Installez-le avec: pip install requests",
        file=sys.stderr,
    )
    sys.exit(1)

def _check_command_exists(cmd: str) -> bool:
    """Vérifie si une commande système existe."""
    return shutil.which(cmd) is not None


def _get_os_name() -> str:
    """Retourne le nom de l'OS de manière simplifiée."""
    system = platform.system().lower()
    if system == "darwin":
        return "macos"
    elif system == "linux":
        return "linux"
    elif system == "windows":
        return "windows"
    else:
        return system


def _get_7z_installation_instructions() -> str:
    """Retourne les instructions d'installation de 7z selon l'OS."""
    os_name = _get_os_name()
    if os_name == "macos":
        return "brew install p7zip"
    elif os_name == "linux":
        return "sudo apt-get install p7zip-full  # ou sudo yum install p7zip-plugins selon la distribution"
    else:
        return "Installez p7zip depuis https://www.7-zip.org/download.html"


def _load_dotenv_file(path: Path, loaded_env: dict[str, str]) -> None:
    """Charge un fichier .env simple en mémoire, sans écraser l'environnement exporté."""
    if not path.exists():
        return

    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()

        if not line or line.startswith("#") or "=" not in line:
            continue

        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip()

        if not key:
            continue

        if (value.startswith('"') and value.endswith('"')) or (
            value.startswith("'") and value.endswith("'")
        ):
            value = value[1:-1]

        def _replace_env_var(match: re.Match[str]) -> str:
            variable_name = match.group(1)
            return os.environ.get(variable_name, loaded_env.get(variable_name, ""))

        value = re.sub(r"\$\{([A-Z0-9_]+)\}", _replace_env_var, value)

        if key not in os.environ:
            loaded_env[key] = value


def _load_project_env() -> None:
    """
    Charge `.env` puis `.env.local`,
    sans écraser les variables déjà exportées dans le shell.
    """
    project_root = Path(__file__).parent.parent
    loaded_env: dict[str, str] = {}

    for env_file in (project_root / ".env", project_root / ".env.local"):
        _load_dotenv_file(env_file, loaded_env)

    for key, value in loaded_env.items():
        os.environ.setdefault(key, value)


def _get_prod_target_config(target: str) -> tuple[str, str]:
    if target == "2025":
        return "BDTOPO_2025_DATABASE_URL", "dialog-bdtopo-2025"

    if target == "2025_2":
        return "BDTOPO_2025_2_DATABASE_URL", "dialog-bdtopo-2025-2"

    raise ValueError(f"Cible de production inconnue: {target}")


def _open_prod_tunnel(target: str, port: int = 10002) -> tuple[subprocess.Popen[str], str]:
    env_var_name, app_name = _get_prod_target_config(target)
    database_url = os.environ.get(env_var_name)

    if not database_url:
        print(
            f"ERROR: {env_var_name} est absente de l'environnement",
            file=sys.stderr,
        )
        return None, ""

    print(f"Ouverture d'un tunnel vers {app_name}...")

    tunnel_proc = subprocess.Popen(
        ["./tools/scalingodbtunnel", app_name, "--host-url", "--port", str(port)],
        stdout=subprocess.PIPE,
        text=True,
    )

    tunnel_url = tunnel_proc.stdout.readline().strip() if tunnel_proc.stdout else ""

    if not tunnel_url:
        tunnel_proc.send_signal(signal.SIGINT)
        tunnel_proc.wait()
        print(
            f"ERROR: impossible d'ouvrir le tunnel vers {app_name}",
            file=sys.stderr,
        )
        return None, ""

    print(f"Tunnel ouvert vers {app_name} sur 127.0.0.1:{port}")

    return tunnel_proc, tunnel_url


def _download_file(url: str, dest_path: Path, chunk_size: int = 8192) -> None:
    """Télécharge un fichier depuis une URL."""
    print(f"Téléchargement: {url}")
    print(f"Destination: {dest_path}")

    response = requests.get(url, stream=True)
    response.raise_for_status()

    total_size = int(response.headers.get("content-length", 0))
    downloaded = 0

    with open(dest_path, "wb") as f:
        for chunk in response.iter_content(chunk_size=chunk_size):
            if chunk:
                f.write(chunk)
                downloaded += len(chunk)
                if total_size > 0:
                    percent = (downloaded / total_size) * 100
                    print(f"\rProgression: {percent:.1f}% ({downloaded}/{total_size} bytes)", end="", flush=True)

    print()  # Nouvelle ligne après la barre de progression
    print(f"✓ Téléchargement terminé: {dest_path}")


def _extract_7z(archive_path: Path, dest_dir: Path, is_multi_volume: bool = False) -> None:
    """
    Extrait une archive .7z.

    Args:
        archive_path: Chemin vers l'archive .7z (ou première partie pour multi-volumes)
        dest_dir: Répertoire de destination
        is_multi_volume: Si True, l'archive est multi-volumes et archive_path est la première partie
    """
    print(f"Extraction de: {archive_path}")

    # Essayer d'abord avec 7z (plus rapide et gère les multi-volumes)
    if _check_command_exists("7z"):
        # 7z peut extraire les archives multi-volumes automatiquement
        # si toutes les parties sont dans le même répertoire
        # 7z peut avoir des chemins différents selon l'OS
        # Sur macOS avec Homebrew, c'est souvent dans /usr/local/bin
        # Sur Linux, c'est généralement dans /usr/bin
        cmd = ["7z", "x", str(archive_path), f"-o{str(dest_dir)}", "-y"]
        result = subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8", errors="replace")
        if result.returncode == 0:
            print(f"✓ Extraction terminée avec 7z")
            return
        else:
            print(f"⚠ 7z a échoué, tentative avec py7zr...")
            if result.stderr:
                print(result.stderr)

    # Fallback sur py7zr (Python)
    # Note: py7zr nécessite que les archives multi-volumes soient fusionnées
    if is_multi_volume:
        install_cmd = _get_7z_installation_instructions()
        print(
            f"ERROR: py7zr ne peut pas extraire directement les archives multi-volumes.\n"
            f"Veuillez installer '7z' (p7zip) avec: {install_cmd}\n"
            f"Ou fusionnez les parties manuellement avant l'extraction.",
            file=sys.stderr,
        )
        sys.exit(1)

    try:
        import py7zr

        with py7zr.SevenZipFile(archive_path, mode="r") as archive:
            archive.extractall(path=dest_dir)
        print(f"✓ Extraction terminée avec py7zr")
    except ImportError:
        install_cmd = _get_7z_installation_instructions()
        print(
            f"ERROR: Aucun outil d'extraction .7z trouvé.\n"
            f"Option 1 - Installer 7z: {install_cmd}\n"
            f"Option 2 - Installer py7zr: pip install py7zr",
            file=sys.stderr,
        )
        sys.exit(1)
    except Exception as e:
        print(f"ERROR: Échec de l'extraction: {e}", file=sys.stderr)
        sys.exit(1)


def _get_latest_date_from_api() -> str:
    """
    Récupère la date de la dernière version en testant directement les URLs.
    Commence par la date d'aujourd'hui et remonte les jours précédents jusqu'à trouver une date valide.
    Retourne la date au format YYYY-MM-DD.
    """
    max_retries = 30
    today = datetime.now()

    print("Recherche de la date de la dernière version disponible...")

    # Tester les URLs en remontant depuis aujourd'hui
    for days_back in range(max_retries):
        test_date = (today - timedelta(days=days_back)).strftime("%Y-%m-%d")
        # Tester si une URL avec cette date existe (en testant le fichier .001)
        # Structure: BDTOPO-EXPRESS_3-5__GPKG_LAMB93_FXX_LATEST/BDTOPO-EXPRESS_3-5__GPKG_LAMB93_FXX_YYYY-MM-DD.7z.001
        test_url = f"https://data.geopf.fr/telechargement/download/BDTOPO_EXPRESS/BDTOPO-EXPRESS_3-5__GPKG_LAMB93_FXX_LATEST/BDTOPO-EXPRESS_3-5__GPKG_LAMB93_FXX_{test_date}.7z.001"

        try:
            # Utiliser HEAD pour vérifier rapidement si le fichier existe
            test_response = requests.head(test_url, timeout=10, allow_redirects=True)
            if test_response.status_code == 200:
                if days_back == 0:
                    print(f"✓ Date trouvée: {test_date} (aujourd'hui)")
                else:
                    print(f"✓ Date trouvée: {test_date} (en remontant {days_back} jour(s))")
                return test_date
        except requests.exceptions.RequestException:
            # En cas d'erreur réseau, continuer avec la date suivante
            pass

    print(
        f"ERROR: Impossible de trouver une date valide après {max_retries} tentatives.",
        file=sys.stderr,
    )
    sys.exit(1)


def _get_download_urls_from_page() -> list[str]:
    """
    Récupère les URLs de téléchargement en construisant les URLs avec la date de la dernière version.
    Retourne les URLs pour la version LATEST de BDTOPO EXPRESS FXX (France métropolitaine).
    """
    # Récupérer la date de la dernière version
    date = _get_latest_date_from_api()

    # Construire les URLs avec le pattern:
    # https://data.geopf.fr/telechargement/download/BDTOPO_EXPRESS/BDTOPO-EXPRESS_3-5__GPKG_LAMB93_FXX_LATEST/BDTOPO-EXPRESS_3-5__GPKG_LAMB93_FXX_YYYY-MM-DD.7z.001 à .006
    base_url = f"https://data.geopf.fr/telechargement/download/BDTOPO_EXPRESS/BDTOPO-EXPRESS_3-5__GPKG_LAMB93_FXX_LATEST/BDTOPO-EXPRESS_3-5__GPKG_LAMB93_FXX_{date}.7z"

    download_urls = []
    # Générer les URLs pour les fichiers .001 à .006
    for i in range(1, 7):
        part_num = f"{i:03d}"  # Format: 001, 002, ..., 006
        url = f"{base_url}.{part_num}"
        download_urls.append(url)

    print(f"✓ {len(download_urls)} fichier(s) à télécharger pour la version du {date}")
    return download_urls


def _merge_7z_parts(parts: list[Path], output_path: Path) -> None:
    """
    Fusionne les parties d'une archive .7z multi-volumes.
    Les archives .7z multi-volumes doivent être fusionnées avant extraction.
    """
    if len(parts) == 1:
        # Pas de fusion nécessaire, juste copier
        shutil.copy2(parts[0], output_path)
        return

    print(f"Fusion de {len(parts)} parties en: {output_path}")

    # Trier les parties par numéro
    sorted_parts = sorted(parts, key=lambda p: int(p.suffix) if p.suffix.isdigit() else 0)

    with open(output_path, "wb") as outfile:
        for part in sorted_parts:
            print(f"  Ajout de: {part.name}")
            with open(part, "rb") as infile:
                shutil.copyfileobj(infile, outfile)

    print(f"✓ Fusion terminée")


def _resolve_target_database_url(args: argparse.Namespace) -> tuple[str | None, str | None]:
    """
    Détermine la base BDTOPO cible pour l'import et les migrations.

    Priorité:
    1. `--url`
    2. `--prod=2025` -> `BDTOPO_2025_DATABASE_URL`
    3. `--prod=2025_2` -> `BDTOPO_2025_2_DATABASE_URL`
    """
    if args.url:
        print("Utilisation de l'URL fournie via --url")
        return args.url, "--url"

    if args.prod == "2025":
        return os.environ.get("BDTOPO_2025_DATABASE_URL"), "BDTOPO_2025_DATABASE_URL"

    if args.prod == "2025_2":
        return os.environ.get("BDTOPO_2025_2_DATABASE_URL"), "BDTOPO_2025_2_DATABASE_URL"

    return None, None


def _extract_millesime(extracted_dir: Path) -> str | None:
    """Extrait le millésime (date d'édition) BD TOPO"""
    for path in extracted_dir.glob("**/*ED[0-9][0-9][0-9][0-9]-*"):
        match = re.search(r"ED(\d{4}-\d{2}-\d{2})", path.name)
        if match:
            return match.group(1)

    # Repli : nom du dossier de livraison de premier niveau
    for path in extracted_dir.iterdir():
        match = re.search(r"(\d{4}-\d{2}-\d{2})", path.name)
        if match:
            return match.group(1)

    return None


def _extract_millesime_from_paths(paths: list[str]) -> str | None:
    """Extrait le millésime BD TOPO depuis les chemins internes d'une archive.

    Utilisé par les pipelines S3 et archive locale, qui n'extraient pas les
    données sur disque mais disposent des chemins des geopackages (manifest).
    """
    for path in paths:
        match = re.search(r"ED(\d{4}-\d{2}-\d{2})", path)
        if match:
            return match.group(1)

    for path in paths:
        match = re.search(r"(\d{4}-\d{2}-\d{2})", path)
        if match:
            return match.group(1)

    return None


def _run_index_migrations(
    database_url_for_migrations: str | None,
    millesime: str | None = None,
) -> None:
    """Recreate BD TOPO indexes/functions after an --overwrite import."""
    print("\n" + "=" * 60)
    print("ÉTAPE 4: Exécution des migrations d'index")
    print("=" * 60)

    # Trouver le répertoire racine du projet (où se trouve le Makefile)
    script_dir = Path(__file__).parent
    project_root = script_dir.parent
    makefile_path = project_root / "Makefile"

    if not makefile_path.exists() or not _check_command_exists("make"):
        reason = (
            f"Makefile introuvable à {makefile_path}"
            if not makefile_path.exists()
            else "make n'est pas disponible"
        )
        print(
            f"WARNING: {reason}. La création des indexes ne sera pas exécutée.",
            file=sys.stderr,
        )
        print(
            "Vous pouvez l'exécuter manuellement avec: make bdtopo_setup_indexes",
            file=sys.stderr,
        )
        return

    # Détecter si on est dans un environnement CI (GitHub Actions)
    is_ci = os.environ.get("CI") == "true" or os.environ.get("GITHUB_ACTIONS") == "true"

    # Utiliser la même URL de base de données que pour l'import
    env = os.environ.copy()
    if database_url_for_migrations:
        env["BDTOPO_DATABASE_URL"] = database_url_for_migrations

    if millesime:
        print(f"Millésime BD TOPO détecté: {millesime}")
    else:
        print(
            "WARNING: millésime BD TOPO introuvable, "
            "la table 'version' ne sera pas mise à jour",
            file=sys.stderr,
        )

    if is_ci:
        console_path = project_root / "bin" / "console"
        if _check_command_exists("php") and console_path.exists():
            setup_cmd = ["php", str(console_path), "app:bdtopo:setup_indexes"]
            if millesime:
                setup_cmd.append(f"--millesime={millesime}")
            print(f"Exécution de: {' '.join(setup_cmd)}")
            print("(Environnement CI détecté, utilisation directe de PHP)")
        else:
            env["BIN_CONSOLE"] = "php bin/console"
            setup_cmd = ["make", "bdtopo_setup_indexes"]
            if millesime:
                setup_cmd.append(f"ARGS=--millesime={millesime}")
            print(f"Exécution de: {' '.join(setup_cmd)}")
            print("(Environnement CI détecté, utilisation du Makefile avec BIN_CONSOLE)")
    else:
        setup_cmd = ["make", "bdtopo_setup_indexes"]
        if millesime:
            setup_cmd.append(f"ARGS=--millesime={millesime}")
        print(f"Exécution de: {' '.join(setup_cmd)}")
        print("(Le Makefile utilisera Docker si PHP n'est pas disponible localement)")

    result = subprocess.run(setup_cmd, env=env, cwd=project_root)

    if result.returncode != 0:
        print(
            "WARNING: La création des indexes a échoué. "
            "Vous pouvez l'exécuter manuellement avec: make bdtopo_setup_indexes",
            file=sys.stderr,
        )
    else:
        print("\n✓ Indexes et fonctions créés avec succès")


def _part_sort_key(path: Path) -> int:
    """Sort multi-volume 7z parts by their .NNN suffix."""
    match = re.search(r"\.(\d+)$", path.name)
    return int(match.group(1)) if match else 0


def _region_from_endpoint(endpoint: str | None) -> str | None:
    """Derive the Outscale region from an endpoint, e.g.
    https://oos.cloudgouv-eu-west-1.outscale.com -> cloudgouv-eu-west-1
    """
    if not endpoint:
        return None

    host = urlparse(endpoint if "://" in endpoint else f"https://{endpoint}").netloc
    match = re.search(r"oos\.([a-z0-9-]+)\.outscale\.com", host)
    return match.group(1) if match else None


def _load_table_names(config_path: Path) -> list[str]:
    """Read the target table names from the bdtopo_update config file."""
    data = json.loads(config_path.read_text(encoding="utf-8"))
    return [table["name"] for table in data["tables"]]


def _list_archive_gpkgs(first_part: Path, table_names: list[str]) -> list[dict]:
    """List the target geopackages inside a (multi-volume) .7z archive.

    Uses `7z l -slt` (technical listing) which prints one `Path = ...` /
    `Size = ...` block per entry. 7z reads the whole multi-volume set from the
    first part (.001), so no concatenation is required here.
    """
    if not _check_command_exists("7z"):
        print(
            "ERROR: 7z est requis pour lister le contenu de l'archive",
            file=sys.stderr,
        )
        return []

    result = subprocess.run(
        ["7z", "l", "-slt", str(first_part)],
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
    )

    if result.returncode != 0:
        print(f"ERROR: `7z l` a échoué:\n{result.stderr or ''}", file=sys.stderr)
        return []

    wanted = {f"{name}.gpkg": name for name in table_names}
    entries: list[dict] = []
    seen: set[str] = set()
    current_path: str | None = None
    current_size: int | None = None

    for line in result.stdout.splitlines():
        if line.startswith("Path = "):
            current_path = line[len("Path = ") :].strip()
            current_size = None
        elif line.startswith("Size = ") and current_path is not None:
            raw = line[len("Size = ") :].strip()
            current_size = int(raw) if raw.isdigit() else None
        elif not line.strip() and current_path is not None:
            normalized = current_path.replace("\\", "/")
            basename = normalized.split("/")[-1]
            table = wanted.get(basename)

            if (
                table is not None
                and table not in seen
                and any(theme in normalized for theme in ("TRANSPORT", "ADRESSES"))
            ):
                entries.append(
                    {"table": table, "path": normalized, "size": current_size}
                )
                seen.add(table)

            current_path = None
            current_size = None

    return entries


def _stream_upload_to_s3(
    parts: list[Path],
    bucket: str,
    key: str,
    endpoint: str,
    region: str,
    total_size: int,
    remove_after: bool,
) -> int:
    """Stream the concatenation of the multi-volume parts into a single S3 object.

    The 6 IGN parts are a plain byte-split of one .7z container, so streaming them
    in order reconstructs the original single-volume archive. Using `aws s3 cp -`
    performs a multipart upload without ever materializing the ~40 GB archive on
    disk (and frees each part as it is consumed).
    """
    if not _check_command_exists("aws"):
        print("ERROR: l'AWS CLI est requis pour l'upload S3", file=sys.stderr)
        return 1

    env = os.environ.copy()
    env["AWS_ACCESS_KEY_ID"] = os.environ["S3_ACCESS_KEY"]
    env["AWS_SECRET_ACCESS_KEY"] = os.environ["S3_SECRET_KEY"]
    env["AWS_DEFAULT_REGION"] = region
    env["AWS_REGION"] = region

    # Outscale is configured with path-style addressing (pathStyleEndpoint: true).
    subprocess.run(
        ["aws", "configure", "set", "default.s3.addressing_style", "path"],
        env=env,
        check=False,
    )

    endpoint_url = endpoint if "://" in endpoint else f"https://{endpoint}"
    cmd = [
        "aws",
        "s3",
        "cp",
        "-",
        f"s3://{bucket}/{key}",
        "--endpoint-url",
        endpoint_url,
        "--expected-size",
        str(total_size),
    ]

    print(f"Upload S3 en flux vers s3://{bucket}/{key} ({_sizeof_fmt(total_size)})")
    proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, env=env)

    try:
        for part in parts:
            print(f"  -> flux: {part.name}")
            with open(part, "rb") as f:
                shutil.copyfileobj(f, proc.stdin)
            if remove_after:
                part.unlink()
    finally:
        if proc.stdin is not None:
            proc.stdin.close()

    return proc.wait()


def _sizeof_fmt(num: float, suffix: str = "B") -> str:
    for unit in ("", "Ki", "Mi", "Gi", "Ti", "Pi"):
        if abs(num) < 1024.0:
            return f"{num:3.1f} {unit}{suffix}"
        num /= 1024.0
    return f"{num:.1f} Yi{suffix}"


def _run_bdtopo_update(
    args: argparse.Namespace,
    source_cmd: list[str],
    millesime: str | None = None,
) -> int:
    """Run tools/bdtopo_update with the given source-specific arguments.

    Handles the Scalingo tunnel (--prod) or the direct --url, the --overwrite/-y
    flags and the post-import index migrations, so that both the S3 and the local
    archive pipelines share the same import/tunnel/migration logic.
    """
    bdtopo_update_script = Path(__file__).parent / "bdtopo_update"

    if not bdtopo_update_script.exists():
        print(
            f"ERROR: Script bdtopo_update introuvable: {bdtopo_update_script}",
            file=sys.stderr,
        )
        return 1

    cmd = [str(bdtopo_update_script), *source_cmd]

    tunnel_proc = None
    database_url_for_migrations = None

    if args.prod:
        tunnel_proc, tunnel_url = _open_prod_tunnel(args.prod)
        if tunnel_proc is None:
            return 1

        cmd.extend(["--url", tunnel_url])
        database_url_for_migrations = tunnel_url
    elif args.url:
        cmd.extend(["--url", args.url])
        database_url_for_migrations = args.url
    else:
        print(
            "ERROR: veuillez fournir --url ou --prod [2025|2025_2]",
            file=sys.stderr,
        )
        return 1

    if args.overwrite:
        cmd.append("--overwrite")
    if args.yes:
        cmd.append("-y")

    print(f"Exécution de: {' '.join(cmd)}")
    try:
        result = subprocess.run(cmd)
    finally:
        if tunnel_proc is not None:
            print("Fermeture du tunnel...")
            tunnel_proc.send_signal(signal.SIGINT)
            tunnel_proc.wait()

    if result.returncode != 0:
        print("ERROR: L'import a échoué", file=sys.stderr)
        return result.returncode

    print("\n✓ Import terminé avec succès")

    if args.overwrite and not args.skip_migrate:
        _run_index_migrations(database_url_for_migrations, millesime=millesime)

    return 0


def _run_s3_pipeline(
    args: argparse.Namespace, download_dir: Path, archives_dir: Path
) -> int:
    """S3 streaming pipeline: download -> upload single archive -> stream import.

    Avoids the ~140 GB local extraction entirely: the import reads each target
    geopackage directly inside the .7z archive stored on S3 via GDAL's
    /vsi7z//vsis3/ virtual filesystems.
    """
    print("=" * 60)
    print("MODE S3: téléchargement, upload de l'archive, import en flux")
    print("=" * 60)

    # 1. Téléchargement des parties (sauf --skip-download)
    if not args.skip_download:
        archives_dir.mkdir(parents=True, exist_ok=True)
        download_urls = args.urls or _get_download_urls_from_page()
        parts = []
        for url in download_urls:
            filename = Path(urlparse(url).path).name
            dest_path = archives_dir / filename
            _download_file(url, dest_path)
            parts.append(dest_path)
    else:
        parts = list(archives_dir.glob("*.7z.*"))
        if not parts:
            print(
                f"ERROR: aucune partie .7z trouvée dans {archives_dir}",
                file=sys.stderr,
            )
            return 1

    parts = sorted(parts, key=_part_sort_key)
    first_part = parts[0]

    # 2. Résolution de la configuration S3
    bucket = args.s3_bucket or os.environ.get("S3_BUCKET")
    endpoint = args.s3_endpoint or os.environ.get("S3_ENDPOINT")
    region = args.s3_region or _region_from_endpoint(endpoint)
    key = args.s3_key

    missing = [
        name
        for name, value in [
            ("bucket S3 (--s3-bucket / S3_BUCKET)", bucket),
            ("endpoint S3 (--s3-endpoint / S3_ENDPOINT)", endpoint),
            ("région S3 (--s3-region)", region),
            ("S3_ACCESS_KEY", os.environ.get("S3_ACCESS_KEY")),
            ("S3_SECRET_KEY", os.environ.get("S3_SECRET_KEY")),
        ]
        if not value
    ]
    if missing:
        print(
            f"ERROR: configuration S3 incomplète: {', '.join(missing)}",
            file=sys.stderr,
        )
        return 1

    # 3. Énumération des geopackages cibles dans l'archive
    config_path = Path(__file__).parent / "bdtopo_update.config.json"
    table_names = _load_table_names(config_path)
    entries = _list_archive_gpkgs(first_part, table_names)

    if not entries:
        print(
            "ERROR: aucun geopackage cible trouvé dans l'archive",
            file=sys.stderr,
        )
        return 1

    print(f"✓ {len(entries)} table(s) repérée(s) dans l'archive:")
    for entry in entries:
        print(f"   - {entry['table']}: {entry['path']}")

    # 4. Upload de la concaténation (mono-archive) vers S3
    total_size = sum(part.stat().st_size for part in parts)
    upload_ret = _stream_upload_to_s3(
        parts,
        bucket,
        key,
        endpoint,
        region,
        total_size,
        remove_after=not args.keep_archives,
    )
    if upload_ret != 0:
        print("ERROR: échec de l'upload S3", file=sys.stderr)
        return upload_ret

    print(f"✓ Archive uploadée: s3://{bucket}/{key}")

    # 5. Écriture du manifest
    manifest_path = download_dir / "bdtopo_manifest.json"
    manifest_path.write_text(
        json.dumps({"entries": entries}, indent=2), encoding="utf-8"
    )
    print(f"✓ Manifest écrit: {manifest_path}")

    # 6. Import en flux (sauf --skip-import)
    if args.skip_import:
        print("⏭ Import ignoré (--skip-import)")
        return 0

    return _run_bdtopo_update(
        args,
        [
            "--s3-archive",
            f"s3://{bucket}/{key}",
            "--manifest",
            str(manifest_path),
            "--s3-endpoint",
            endpoint,
            "--s3-region",
            region,
        ],
        millesime=_extract_millesime_from_paths([entry["path"] for entry in entries]),
    )


def _run_local_archive_pipeline(
    args: argparse.Namespace, download_dir: Path, archives_dir: Path
) -> int:
    """Local pipeline without S3: download the parts, concatenate them into a single
    .7z inside the download directory (dump/), then import each geopackage directly
    from that archive via GDAL /vsi7z/ (no ~140 GB extraction).
    """
    print("=" * 60)
    print("MODE ARCHIVE LOCALE: téléchargement, concaténation, import via /vsi7z/")
    print("=" * 60)

    archive_path = archives_dir / "bdtopo-latest.7z"

    if not args.skip_download:
        # 1. Téléchargement des parties
        archives_dir.mkdir(parents=True, exist_ok=True)
        download_urls = args.urls or _get_download_urls_from_page()
        parts = []
        for url in download_urls:
            filename = Path(urlparse(url).path).name
            dest_path = archives_dir / filename
            _download_file(url, dest_path)
            parts.append(dest_path)

        parts = sorted(parts, key=_part_sort_key)

        # 2. Concaténation en une archive mono-volume dans archives/
        _merge_7z_parts(parts, archive_path)

        if not args.keep_archives:
            for part in parts:
                part.unlink()
    else:
        if not archive_path.exists():
            print(
                f"ERROR: archive concaténée introuvable: {archive_path}",
                file=sys.stderr,
            )
            return 1
        print(f"✓ Réutilisation de l'archive existante: {archive_path}")

    # 3. Énumération des geopackages cibles dans l'archive
    config_path = Path(__file__).parent / "bdtopo_update.config.json"
    table_names = _load_table_names(config_path)
    entries = _list_archive_gpkgs(archive_path, table_names)

    if not entries:
        print(
            "ERROR: aucun geopackage cible trouvé dans l'archive",
            file=sys.stderr,
        )
        return 1

    print(f"✓ {len(entries)} table(s) repérée(s) dans l'archive:")
    for entry in entries:
        print(f"   - {entry['table']}: {entry['path']}")

    # 4. Écriture du manifest dans archives/
    manifest_path = archives_dir / "bdtopo_manifest.json"
    manifest_path.write_text(
        json.dumps({"entries": entries}, indent=2), encoding="utf-8"
    )
    print(f"✓ Manifest écrit: {manifest_path}")

    # 5. Import via /vsi7z/ (sauf --skip-import)
    if args.skip_import:
        print("⏭ Import ignoré (--skip-import)")
        return 0

    return _run_bdtopo_update(
        args,
        [
            "--archive",
            str(archive_path),
            "--manifest",
            str(manifest_path),
        ],
        millesime=_extract_millesime_from_paths([entry["path"] for entry in entries]),
    )



def main() -> int:
    _load_project_env()

    parser = argparse.ArgumentParser(
        description="Télécharge, dézippe et importe les données BDTOPO EXPRESS",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    parser.add_argument(
        "--download-dir",
        type=Path,
        default=None,  # Sera défini plus bas
        help="Répertoire de téléchargement (défaut: ./dump dans le projet)",
    )
    parser.add_argument(
        "--keep-archives",
        action="store_true",
        help="Conserver les archives .7z après dézippage",
    )
    parser.add_argument(
        "--skip-download",
        action="store_true",
        help="Ignorer le téléchargement (utiliser fichiers existants)",
    )
    parser.add_argument(
        "--skip-import",
        action="store_true",
        help="Ignorer l'import (seulement télécharger/dézipper)",
    )
    parser.add_argument(
        "--urls",
        nargs="+",
        help="URLs de téléchargement manuelles (sinon récupérées automatiquement)",
    )
    parser.add_argument(
        "--url",
        help="URL de la base PostgreSQL (au lieu de --prod)",
    )
    parser.add_argument(
        "--prod",
        nargs="?",
        const="2025",
        default=None,
        choices=["2025", "2025_2"],
        help="Déployer vers une base de production (`2025` par défaut, ou `2025_2`)",
    )
    parser.add_argument(
        "--overwrite",
        action="store_true",
        help="Réécrire les tables au lieu d'ajouter",
    )
    parser.add_argument(
        "-y",
        "--yes",
        action="store_true",
        help="Accepter toutes les confirmations",
    )
    parser.add_argument(
        "--skip-migrate",
        action="store_true",
        help="Ignorer l'exécution des migrations d'index après l'import",
    )
    parser.add_argument(
        "--s3",
        action="store_true",
        help=(
            "Mode S3: uploader l'archive concaténée sur S3 (Outscale) puis importer "
            "en flux via GDAL /vsi7z//vsis3/ sans extraction locale (~140 Go évités)"
        ),
    )
    parser.add_argument(
        "--local-archive",
        action="store_true",
        help=(
            "Mode archive locale: télécharger, concaténer les parties en un seul .7z "
            "dans dump/, puis importer chaque geopackage directement via GDAL /vsi7z/ "
            "(sans S3 ni extraction des ~140 Go). Recommandé pour tester en local."
        ),
    )
    parser.add_argument(
        "--s3-bucket",
        default=None,
        help="Bucket S3 cible (défaut: variable d'environnement S3_BUCKET)",
    )
    parser.add_argument(
        "--s3-key",
        default="bdtopo/bdtopo-latest.7z",
        help="Clé de l'objet S3 (défaut: bdtopo/bdtopo-latest.7z)",
    )
    parser.add_argument(
        "--s3-endpoint",
        default=None,
        help="Endpoint S3 (défaut: variable d'environnement S3_ENDPOINT)",
    )
    parser.add_argument(
        "--s3-region",
        default=None,
        help=(
            "Région S3 (défaut: déduite de l'endpoint Outscale, "
            "ex. cloudgouv-eu-west-1)"
        ),
    )

    args = parser.parse_args()

    # Définir le répertoire de téléchargement par défaut
    if args.download_dir is None:
        # Détecter si on est dans un environnement CI (GitHub Actions)
        is_ci = os.environ.get("CI") == "true" or os.environ.get("GITHUB_ACTIONS") == "true"

        if is_ci:
            # Dans la CI, utiliser /tmp qui a généralement plus d'espace disponible
            default_download_dir = Path("/tmp/bdtopo_download")
            print(f"Utilisation du répertoire par défaut pour la CI: {default_download_dir}")
        else:
            # En local, utiliser ./dump dans le répertoire du projet
            # (évite les problèmes de RAM sur Linux où /tmp est monté en RAM)
            script_dir = Path(__file__).parent
            project_root = script_dir.parent
            default_download_dir = project_root / "dump"
            print(f"Utilisation du répertoire par défaut: {default_download_dir}")
            print("(Note: ce répertoire est dans .gitignore)")

        download_dir = default_download_dir
    else:
        download_dir = args.download_dir

    try:
        download_dir = download_dir.resolve()
    except (OSError, RuntimeError) as e:
        print(
            f"ERROR: Impossible de résoudre le chemin {download_dir}: {e}",
            file=sys.stderr,
        )
        return 1
    archives_dir = download_dir / "archives"
    extracted_dir = download_dir / "extracted"

    # Mode S3: pipeline dédié (upload archive + import en flux, sans extraction)
    if args.s3:
        return _run_s3_pipeline(args, download_dir, archives_dir)

    # Mode archive locale: concaténation dans dump/ + import via /vsi7z/ (sans S3)
    if args.local_archive:
        return _run_local_archive_pipeline(args, download_dir, archives_dir)

    # Étape 1: Téléchargement
    if not args.skip_download:
        print("=" * 60)
        print("ÉTAPE 1: Téléchargement des archives")
        print("=" * 60)

        archives_dir.mkdir(parents=True, exist_ok=True)

        if args.urls:
            download_urls = args.urls
        else:
            download_urls = _get_download_urls_from_page()

        downloaded_parts = []
        for url in download_urls:
            filename = Path(urlparse(url).path).name
            dest_path = archives_dir / filename
            _download_file(url, dest_path)
            downloaded_parts.append(dest_path)

        print(f"\n✓ Tous les téléchargements terminés dans: {archives_dir}")

        # Détecter si c'est une archive multi-volumes
        # Les archives multi-volumes ont des extensions .001, .002, etc.
        base_names = {}
        for part in downloaded_parts:
            # Chercher le nom de base (sans .001, .002, etc.)
            # Format: BDTOPO-EXPRESS_3-5__GPKG_LAMB93_FXX_2026-01-18.7z.001
            base_match = re.match(r"(.+\.7z)(?:\.(\d+))?$", part.name)
            if base_match:
                base_name = base_match.group(1)
                if base_name not in base_names:
                    base_names[base_name] = []
                base_names[base_name].append(part)

        # Étape 2: Fusion et extraction
        print("\n" + "=" * 60)
        print("ÉTAPE 2: Fusion et extraction des archives")
        print("=" * 60)

        extracted_dir.mkdir(parents=True, exist_ok=True)

        for base_name, parts in base_names.items():
            if len(parts) > 1:
                # Archive multi-volumes: 7z peut extraire directement si toutes les parties sont présentes
                print(f"Archive multi-volumes détectée: {base_name} ({len(parts)} parties)")

                # Trier les parties par numéro pour s'assurer qu'elles sont dans le bon ordre
                sorted_parts = sorted(
                    parts,
                    key=lambda p: int(re.search(r"\.(\d+)$", p.name).group(1))
                    if re.search(r"\.(\d+)$", p.name)
                    else 0,
                )

                # Vérifier que toutes les parties sont présentes (001, 002, ...)
                if len(sorted_parts) > 0:
                    print(f"Parties trouvées: {', '.join(p.name for p in sorted_parts)}")

                # Essayer d'extraire directement avec 7z (plus efficace)
                if _check_command_exists("7z"):
                    # 7z peut extraire les archives multi-volumes directement
                    # Il suffit de spécifier la première partie
                    first_part = sorted_parts[0]
                    _extract_7z(first_part, extracted_dir, is_multi_volume=True)
                    archive_to_extract = first_part
                else:
                    # Avec py7zr, il faut fusionner d'abord
                    merged_path = archives_dir / base_name
                    _merge_7z_parts(sorted_parts, merged_path)
                    _extract_7z(merged_path, extracted_dir, is_multi_volume=False)
                    archive_to_extract = merged_path
            else:
                # Archive simple
                archive_to_extract = parts[0]
                _extract_7z(archive_to_extract, extracted_dir, is_multi_volume=False)

            if not args.keep_archives:
                # Supprimer les parties après extraction
                for part in parts:
                    if part.exists() and part != archive_to_extract:
                        part.unlink()
                # Supprimer l'archive fusionnée si elle existe et est différente des parties
                merged_path = archives_dir / base_name
                if merged_path.exists() and merged_path != archive_to_extract:
                    merged_path.unlink()

        print(f"\n✓ Extraction terminée dans: {extracted_dir}")
    else:
        print("⏭ Téléchargement ignoré (--skip-download)")
        if not extracted_dir.exists():
            print(
                f"ERROR: Le répertoire d'extraction {extracted_dir} n'existe pas",
                file=sys.stderr,
            )
            return 1

    # Étape 3: Import
    if not args.skip_import:
        print("\n" + "=" * 60)
        print("ÉTAPE 3: Import dans la base de données")
        print("=" * 60)

        bdtopo_update_script = Path(__file__).parent / "bdtopo_update"
        if not bdtopo_update_script.exists():
            print(
                f"ERROR: Script bdtopo_update introuvable: {bdtopo_update_script}",
                file=sys.stderr,
            )
            return 1

        cmd = [
            str(bdtopo_update_script),
            str(extracted_dir),
        ]

        database_url_from_env, database_url_source = _resolve_target_database_url(args)
        database_url_for_migrations = None  # Sera utilisé pour les migrations
        tunnel_proc = None

        if args.prod:
            tunnel_proc, tunnel_url = _open_prod_tunnel(args.prod)
            if tunnel_proc is None:
                return 1

            cmd.extend(["--url", tunnel_url])
            database_url_for_migrations = tunnel_url
            print(f"Base cible sélectionnée via {database_url_source}")
        elif args.url:
            cmd.extend(["--url", args.url])
            database_url_for_migrations = args.url
        else:
            print(
                "ERROR: veuillez fournir --url ou --prod [2025|2025_2]",
                file=sys.stderr,
            )
            return 1

        if args.overwrite:
            cmd.append("--overwrite")
        if args.yes:
            cmd.append("-y")

        print(f"Exécution de: {' '.join(cmd)}")
        try:
            result = subprocess.run(cmd)
        finally:
            if tunnel_proc is not None:
                print("Fermeture du tunnel...")
                tunnel_proc.send_signal(signal.SIGINT)
                tunnel_proc.wait()

        if result.returncode != 0:
            print("ERROR: L'import a échoué", file=sys.stderr)
            return result.returncode

        print("\n✓ Import terminé avec succès")

        # Étape 4: Migrations d'index (si --overwrite et pas --skip-migrate)
        if args.overwrite and not args.skip_migrate:
            _run_index_migrations(
                database_url_for_migrations,
                millesime=_extract_millesime(extracted_dir),
            )
    else:
        print("⏭ Import ignoré (--skip-import)")

    print("\n" + "=" * 60)
    print("✓ Processus terminé avec succès")
    print("=" * 60)
    print(f"Données extraites dans: {extracted_dir}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
