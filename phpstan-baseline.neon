			path: src/Domain/Regulation/Measure.php

		-
			message: '#^Property App\\Domain\\Regulation\\RegulationOrder\:\:\$regulationOrderRecord \(App\\Domain\\Regulation\\RegulationOrderRecord\|null\) is never assigned App\\Domain\\Regulation\\RegulationOrderRecord so it can be removed from the property type\.$#'
			identifier: property.unusedType
			count: 1
			path: src/Domain/Regulation/RegulationOrder.php

		-
			message: '#^Property App\\Domain\\User\\Organization\:\:\$geometry \(string\|null\) is never assigned null so it can be removed from the property type\.$#'
