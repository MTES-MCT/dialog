parameters:
	ignoreErrors:
		-
			message: '#^Using nullsafe property access "\?\-\>geometry" in empty\(\) is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Application/Regulation/Command/Location/SaveWholeCityExceptionCommand.php

		-
			message: '#^Using nullsafe property access "\?\-\>roadBanId" in empty\(\) is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/Application/Regulation/Command/Location/SaveWholeCityExceptionCommand.php

		-
			message: '#^Negated boolean expression is always true\.$#'
