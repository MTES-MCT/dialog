<?xml version="1.0" encoding="UTF-8"?>
<constraint-mapping xmlns="http://symfony.com/schema/dic/constraint-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/constraint-mapping https://symfony.com/schema/dic/constraint-mapping/constraint-mapping-1.0.xsd">
    <class name="App\Application\Regulation\Command\Location\SaveNamedStreetCommand">
        <getter property="isEntireStreet">
            <constraint name="Type">
                <option name="type">boolean</option>
            </constraint>
        </getter>
        <property name="cityCode">
            <constraint name="Length">
                <option name="min">5</option>
                <option name="max">5</option>
            </constraint>
            <constraint name="When">
                <option name="expression">this.roadType === 'lane'</option>
                <option name="constraints">
                    <constraint name="NotBlank">
                        <option name="message">regulation.location.cityCode.error.blank</option>
                    </constraint>
                </option>
            </constraint>
        </property>
        <property name="cityLabel">
            <constraint name="When">
                <option name="expression"> this.roadType === 'lane' </option>
                <option name="constraints">
                    <constraint name="NotBlank" />
                    <constraint name="Length">
                        <option name="max">255</option>
                    </constraint>
                </option>
            </constraint>
        </property>
        <property name="roadBanId">
            <constraint name="Length">
                <option name="max">20</option>
            </constraint>
            <constraint name="When">
                <option name="expression"> this.roadType === 'lane' </option>
                <option name="constraints">
                    <constraint name="NotBlank">
                        <option name="message">regulation.location.roadBanId.error.blank</option>
                        <option name="groups">
                            <value>html_form</value>
                        </option>
                    </constraint>
                </option>
            </constraint>
        </property>
        <property name="roadName">
            <constraint name="When">
                <option name="expression"> this.roadType === 'lane' </option>
                <option name="constraints">
                    <constraint name="NotBlank" />
                    <constraint name="Length">
                        <option name="max">255</option>
                    </constraint>
                </option>
            </constraint>
        </property>
        <!-- Hors « voie entière », un point de début sans point de fin (ou l'inverse) ne permet
             pas de calculer la section de voie. Limité aux nouvelles voies pour ne pas bloquer
             l'édition de données existantes dont la géométrie est déjà enregistrée. -->
        <property name="fromPointType">
            <constraint name="When">
                <option name="expression">this.roadType === 'lane' and this.namedStreet === null and !this.getIsEntireStreet() and (this.toCoords or this.toHouseNumber or this.toRoadName) and !this.fromCoords and !this.fromHouseNumber and !this.fromRoadName</option>
                <option name="constraints">
                    <constraint name="NotBlank" />
                </option>
            </constraint>
        </property>
        <property name="toPointType">
            <constraint name="When">
                <option name="expression">this.roadType === 'lane' and this.namedStreet === null and !this.getIsEntireStreet() and (this.fromCoords or this.fromHouseNumber or this.fromRoadName) and !this.toCoords and !this.toHouseNumber and !this.toRoadName</option>
                <option name="constraints">
                    <constraint name="NotBlank" />
                </option>
            </constraint>
        </property>
        <property name="fromHouseNumber">
            <constraint name="Length">
                <option name="max">8</option>
            </constraint>
            <constraint name="When">
                <option name="expression">this.roadType === 'lane' and !this.getIsEntireStreet() and this.fromPointType === 'houseNumber'</option>
                <option name="constraints">
                    <constraint name="NotBlank" />
                </option>
            </constraint>
        </property>
        <property name="fromRoadBanId">
            <constraint name="Length">
                <option name="max">20</option>
            </constraint>
            <constraint name="When">
                <option name="expression">this.roadType === 'lane' and !this.getIsEntireStreet() and this.fromPointType === 'intersection'</option>
                <option name="constraints">
                    <constraint name="NotBlank">
                        <option name="message">regulation.location.roadBanId.error.blank</option>
                        <option name="groups">
                            <value>html_form</value>
                        </option>
                    </constraint>
                </option>
            </constraint>
        </property>
        <property name="fromRoadName">
            <constraint name="Length">
                <option name="max">255</option>
            </constraint>
            <constraint name="When">
                <option name="expression">this.roadType === 'lane' and !this.getIsEntireStreet() and this.fromPointType === 'intersection'</option>
                <option name="constraints">
                    <constraint name="NotBlank" />
                </option>
            </constraint>
        </property>
        <property name="toHouseNumber">
            <constraint name="Length">
                <option name="max">8</option>
            </constraint>
            <constraint name="When">
                <option name="expression">this.roadType === 'lane' and !this.getIsEntireStreet() and this.toPointType === 'houseNumber'</option>
                <option name="constraints">
                    <constraint name="NotBlank" />
                </option>
            </constraint>
        </property>
        <property name="toRoadBanId">
            <constraint name="Length">
                <option name="max">20</option>
            </constraint>
            <constraint name="When">
                <option name="expression">this.roadType === 'lane' and !this.getIsEntireStreet() and this.toPointType === 'intersection'</option>
                <option name="constraints">
                    <constraint name="NotBlank">
                        <option name="message">regulation.location.roadBanId.error.blank</option>
                        <option name="groups">
                            <value>html_form</value>
                        </option>
                    </constraint>
                </option>
            </constraint>
        </property>
        <property name="toRoadName">
            <constraint name="Length">
                <option name="max">255</option>
            </constraint>
            <constraint name="When">
                <option name="expression">this.roadType === 'lane' and !this.getIsEntireStreet() and this.toPointType === 'intersection'</option>
                <option name="constraints">
                    <constraint name="NotBlank" />
                </option>
            </constraint>
        </property>
    </class>
</constraint-mapping>
